// Dashboard reads the remote ECU frame, and fails safe after 200 ms without a frame.
void setup(){pinMode(GP6,OUTPUT);digitalWrite(GP6,HIGH);SPI.begin();SPI.setClockDivider(32);digitalWrite(GP6,LOW);SPI.transfer(192);digitalWrite(GP6,HIGH);digitalWrite(GP6,LOW);SPI.transfer(2);SPI.transfer(40);SPI.transfer(5);digitalWrite(GP6,HIGH);digitalWrite(GP6,LOW);SPI.transfer(2);SPI.transfer(41);SPI.transfer(177);digitalWrite(GP6,HIGH);digitalWrite(GP6,LOW);SPI.transfer(2);SPI.transfer(42);SPI.transfer(0);digitalWrite(GP6,HIGH);digitalWrite(GP6,LOW);SPI.transfer(2);SPI.transfer(96);SPI.transfer(96);digitalWrite(GP6,HIGH);digitalWrite(GP6,LOW);SPI.transfer(2);SPI.transfer(112);SPI.transfer(96);digitalWrite(GP6,HIGH);digitalWrite(GP6,LOW);SPI.transfer(2);SPI.transfer(15);SPI.transfer(8);digitalWrite(GP6,HIGH);Serial2.begin(115200);pinMode(GP7,OUTPUT);int cycles=0;int received=0;int faults=0;int alarm=0;int remoteFaults=0;int remoteExcursions=0;double lastSeen=0;}void loop(){digitalWrite(GP6,LOW);SPI.transfer(3);SPI.transfer(44);int flags=SPI.transfer(0);digitalWrite(GP6,HIGH);if((flags&1)!=0){digitalWrite(GP6,LOW);SPI.transfer(3);SPI.transfer(97);int idHi=SPI.transfer(0);int idLo=SPI.transfer(0);SPI.transfer(0);SPI.transfer(0);int dlc=SPI.transfer(0);int f=SPI.transfer(0);int e=SPI.transfer(0);int co=SPI.transfer(0);int pressure=SPI.transfer(0);digitalWrite(GP6,HIGH);if(idHi*8+idLo/32==801 && dlc==4){remoteFaults=f;remoteExcursions=e;lastSeen=millis();received=received+1;}digitalWrite(GP6,LOW);SPI.transfer(5);SPI.transfer(44);SPI.transfer(1);SPI.transfer(0);digitalWrite(GP6,HIGH);}faults=remoteFaults;if(millis()-lastSeen>200){faults=faults+1;}alarm=0;if(faults>0 || remoteExcursions>0){alarm=1;}digitalWrite(GP7,alarm);Serial2.println(faults);cycles=cycles+1;delay(10);}