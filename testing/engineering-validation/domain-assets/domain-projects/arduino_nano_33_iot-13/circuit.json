Settings":{"maxIterations":80,"advancedEmbedded":false,"analysis":"DC","tolerance":1.0E-8},"firmware":[{"boardId":"B1","language":"ARDUINO_SUBSET","source":"// Dashboard reads the remote ECU frame, and fails safe after 200 ms without a frame.\nvoid setup(){pinMode(D2,OUTPUT);digitalWrite(D2,HIGH);SPI.begin();SPI.setClockDivider(32);digitalWrite(D2,LOW);SPI.transfer(192);digitalWrite(D2,HIGH);digitalWrite(D2,LOW);SPI.transfer(2);SPI.transfer(40);SPI.transfer(5);digitalWrite(D2,HIGH);digitalWrite(D2,LOW);SPI.transfer(2);SPI.transfer(41);SPI.transfer(177);digitalWrite(D2,HIGH);digitalWrite(D2,LOW);SPI.transfer(2);SPI.transfer(42);SPI.transfer(0);digitalWrite(D2,HIGH);digitalWrite(D2,LOW);SPI.transfer(2);SPI.transfer(96);SPI.transfer(96);digitalWrite(D2,HIGH);digitalWrite(D2,LOW);SPI.transfer(2);SPI.transfer(112);SPI.transfer(96);digitalWrite(D2,HIGH);digitalWrite(D2,LOW);SPI.transfer(2);SPI.transfer(15);SPI.transfer(8);digitalWrite(D2,HIGH);Serial1.begin(115200);pinMode(D3,OUTPUT);int cycles=0;int received=0;int faults=0;int alarm=0;int remoteFaults=0;int remoteExcursions=0;double lastSeen=0;}void loop(){digitalWrite(D2,LOW);SPI.transfer(3);SPI.transfer(44);int flags=SPI.transfer(0);digitalWrite(D2,HIGH);if((flags&1)!=0){digitalWrite(D2,LOW);SPI.transfer(3);SPI.transfer(97);int idHi=SPI.transfer(0);int idLo=SPI.transfer(0);SPI.transfer(0);SPI.transfer(0);int dlc=SPI.transfer(0);int f=SPI.transfer(0);int e=SPI.transfer(0);int co=SPI.transfer(0);int pressure=SPI.transfer(0);digitalWrite(D2,HIGH);if(idHi*8+idLo/32==801 && dlc==4){remoteFaults=f;remoteExcursions=e;lastSeen=millis();received=received+1;}digitalWrite(D2,LOW);SPI.transfer(5);SPI.transfer(44);SPI.transfer(1);SPI.transfer(0);digitalWrite(D2,HIGH);}faults=remoteFaults;if(millis()-lastSeen>200){faults=faults+1;}alarm=0;if(faults>0 || remoteExcursions>0){alarm=1;}digitalWrite(D3,alarm);Serial1.println(faults);cycles=cycles+1;delay(10);}","usbPower":true},{"boardId":"ECU","language":"ARDUINO_SUBSET","source":"// ECU reads eight independent thermal probes, CO and pressure. Classical CAN ID 0x321, four diagnostic bytes.\nvoid setup(){Wire.begin();pinMode(D10,OUTPUT);digitalWrite(D10,HIGH);SPI.begin();SPI.setClockDivider(32);digitalWrite(D10,LOW);SPI.transfer(192);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(40);SPI.transfer(5);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(41);SPI.transfer(177);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(42);SPI.transfer(0);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(96);SPI.transfer(96);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(112);SPI.transfer(96);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(15);SPI.transfer(8);digitalWrite(D10,HIGH);int cycles=0;int faults=0;int excursions=0;double co=0;double pressure=0;double t0=0;double t1=0;double t2=0;double t3=0;double t4=0;double t5=0;double t6=0;double t7=0;}void loop(){faults=0;excursions=0;Wire.beginTransmission(72);Wire.write(0);int ack0=Wire.endTransmission(false);int n0=Wire.requestFrom(72,2);int hi0=Wire.read();int lo0=Wire.read();if(ack0==0 && n0==2){int raw0=hi0*256+lo0;if(raw0>=32768){raw0=raw0-65536;}t0=raw0/256.0;if(t0<0 || t0>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(73);Wire.write(0);int ack1=Wire.endTransmission(false);int n1=Wire.requestFrom(73,2);int hi1=Wire.read();int lo1=Wire.read();if(ack1==0 && n1==2){int raw1=hi1*256+lo1;if(raw1>=32768){raw1=raw1-65536;}t1=raw1/256.0;if(t1<0 || t1>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(74);Wire.write(0);int ack2=Wire.endTransmission(false);int n2=Wire.requestFrom(74,2);int hi2=Wire.read();int lo2=Wire.read();if(ack2==0 && n2==2){int raw2=hi2*256+lo2;if(raw2>=32768){raw2=raw2-65536;}t2=raw2/256.0;if(t2<0 || t2>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(75);Wire.write(0);int ack3=Wire.endTransmission(false);int n3=Wire.requestFrom(75,2);int hi3=Wire.read();int lo3=Wire.read();if(ack3==0 && n3==2){int raw3=hi3*256+lo3;if(raw3>=32768){raw3=raw3-65536;}t3=raw3/256.0;if(t3<0 || t3>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(76);Wire.write(0);int ack4=Wire.endTransmission(false);int n4=Wire.requestFrom(76,2);int hi4=Wire.read();int lo4=Wire.read();if(ack4==0 && n4==2){int raw4=hi4*256+lo4;if(raw4>=32768){raw4=raw4-65536;}t4=raw4/256.0;if(t4<0 || t4>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(77);Wire.write(0);int ack5=Wire.endTransmission(false);int n5=Wire.requestFrom(77,2);int hi5=Wire.read();int lo5=Wire.read();if(ack5==0 && n5==2){int raw5=hi5*256+lo5;if(raw5>=32768){raw5=raw5-65536;}t5=raw5/256.0;if(t5<0 || t5>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(78);Wire.write(0);int ack6=Wire.endTransmission(false);int n6=Wire.requestFrom(78,2);int hi6=Wire.read();int lo6=Wire.read();if(ack6==0 && n6==2){int raw6=hi6*256+lo6;if(raw6>=32768){raw6=raw6-65536;}t6=raw6/256.0;if(t6<0 || t6>85){excursions=excursions+1;}}else{faults=faults+1;}Wire.beginTransmission(79);Wire.write(0);int ack7=Wire.endTransmission(false);int n7=Wire.requestFrom(79,2);int hi7=Wire.read();int lo7=Wire.read();if(ack7==0 && n7==2){int raw7=hi7*256+lo7;if(raw7>=32768){raw7=raw7-65536;}t7=raw7/256.0;if(t7<0 || t7>85){excursions=excursions+1;}}else{faults=faults+1;}co=((analogRead(A0)+.5)*5.0*2/1024-.4)/.0032;pressure=((analogRead(A1)+.5)*5.0*2/1024/5.1-.04)/.09;if(co>30 || co< -5 || pressure>7 || pressure< -.1){excursions=excursions+1;}digitalWrite(D10,LOW);SPI.transfer(2);SPI.transfer(49);SPI.transfer(100);SPI.transfer(32);SPI.transfer(0);SPI.transfer(0);SPI.transfer(4);SPI.transfer(faults);SPI.transfer(excursions);SPI.transfer(co/2);SPI.transfer(pressure*10);digitalWrite(D10,HIGH);digitalWrite(D10,LOW);SPI.transfer(129);digitalWrite(D10,HIGH);cycles=cycles+1;delay(100);}","usbPowe